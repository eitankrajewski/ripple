# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API). The anon key is safe in the browser; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel env vars / .env.local for `npm run dev`): used by /api/doordash.
SUPABASE_SERVICE_ROLE_KEY=
RIPPLE_WEBHOOK_SECRET=

# Optional AI wording.
GEMINI_API_KEY=
